# reading enviroment variable from .env.production
{$DOMAIN} {

    root * /usr/share/caddy
    encode gzip zstd
    file_server # for static file serving

    # Letting caddy safely handle http requests internally on backend
    reverse_proxy /api/* api-gateway:8080

    # if file does not exists run index.html
    try_files {path} /index.html 
}
