{
    "swagger": "2.0",
    "info": {
        "description": "Handles ingestion and retrieval of sensor measurements",
        "title": "Collection Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/api/v1/collection",
    "paths": {
        "/collection/company-config": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "company-config"
                ],
                "summary": "Create tenant mapping",
                "parameters": [
                    {
                        "description": "Tenant mapping payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateTenantMappingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/latest": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "measurements"
                ],
                "summary": "Get latest measurement",
                "parameters": [
                    {
                        "type": "string",
                        "description": "DeviceEUI",
                        "name": "device_eui",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.SensorMeasurement"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/measurements": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "measurements"
                ],
                "summary": "Get measurements by time range",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device EUI",
                        "name": "device_eui",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Start time (RFC3339, e.g. 2024-01-01T00:00:00Z)",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "End time (RFC3339, e.g. 2024-01-02T00:00:00Z)",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.SensorMeasurement"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.SensorMeasurement": {
            "type": "object",
            "properties": {
                "company_id": {
                    "type": "string"
                },
                "device_eui": {
                    "type": "string"
                },
                "payload": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "dto.CreateTenantMappingRequest": {
            "type": "object",
            "properties": {
                "company_id": {
                    "type": "string"
                },
                "tenant_id": {
                    "type": "string"
                }
            }
        }
    }
}