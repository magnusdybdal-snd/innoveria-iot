{
    "swagger": "2.0",
    "info": {
        "description": "Handles context management for sensor data",
        "title": "Context Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8086",
    "basePath": "/api/v1/context",
    "paths": {
        "/data": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "context"
                ],
                "summary": "Get Context Data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Company ID",
                        "name": "company_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Device EUI(s)",
                        "name": "device_eui",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Aggregation Rule ID",
                        "name": "rule_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Period start (RFC3339)",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Period end (RFC3339)",
                        "name": "to",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Bucket size in minutes (overrides rule default)",
                        "name": "bucket_minutes",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.ContextDataResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/rules": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "context"
                ],
                "summary": "Get Aggregation Rules",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Company ID",
                        "name": "company_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.AggregationRuleResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "context"
                ],
                "summary": "Create Aggregation Rule",
                "parameters": [
                    {
                        "description": "Aggregation Rule to create",
                        "name": "rule",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateAggregationRuleRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "409": {
                        "description": "Conflict"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/rules/{rule_id}": {
            "delete": {
                "tags": [
                    "context"
                ],
                "summary": "Delete Aggregation Rule",
                "parameters": [
                    {
                        "type": "string",
                        "description": "id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.AggregationRuleResponse": {
            "type": "object",
            "properties": {
                "aggregation_method": {
                    "type": "string"
                },
                "company_id": {
                    "type": "string"
                },
                "context_type": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "measurement_type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "time_bucket_minutes": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "dto.BucketResponse": {
            "type": "object",
            "properties": {
                "period_end": {
                    "type": "string"
                },
                "period_start": {
                    "type": "string"
                },
                "value": {
                    "type": "number"
                }
            }
        },
        "dto.ContextDataResponse": {
            "type": "object",
            "properties": {
                "buckets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.BucketResponse"
                    }
                },
                "calculated_at": {
                    "type": "string"
                },
                "company_id": {
                    "type": "string"
                },
                "context_type": {
                    "type": "string"
                },
                "device_eui": {
                    "type": "string"
                },
                "period_end": {
                    "type": "string"
                },
                "period_start": {
                    "type": "string"
                },
                "total_value": {
                    "type": "number"
                },
                "unit": {
                    "type": "string"
                }
            }
        },
        "dto.CreateAggregationRuleRequest": {
            "type": "object",
            "required": [
                "aggregation_method",
                "company_id",
                "context_type",
                "measurement_type",
                "name",
                "time_bucket_minutes"
            ],
            "properties": {
                "aggregation_method": {
                    "type": "string"
                },
                "company_id": {
                    "type": "string"
                },
                "context_type": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "measurement_type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "time_bucket_minutes": {
                    "type": "integer"
                }
            }
        }
    }
}