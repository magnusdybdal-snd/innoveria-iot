# Normalize line endings to LF for all text files
* text=auto eol=lf

# Go source files
*.go text eol=lf

# Config and data files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.md text eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
